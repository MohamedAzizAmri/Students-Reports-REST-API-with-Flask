
PORT=5000
HOST_PORT=5000

# Token settings 
ACCESS_TOKEN_MINUTES=1
REFRESH_TOKEN_HOURS=24
SECRET_KEY=change-me-to-a-long-random-string

# Demo login
API_USERNAME=admin
API_PASSWORD=admin123

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Database location. Leave commented to use the default (data/app.db).
# For Docker the default is sqlite:////app/data/app.db
# DATABASE_URL=sqlite:////app/data/app.db